<style>
/* ═══════════════════════════════════════════════════════════════
   TOKENS — cambiá acá los colores y ya cambia toda la página
   ═══════════════════════════════════════════════════════════════ */
:root{
  --tinta:#0F0F0F;          /* texto principal */
  --tinta-suave:#5C5C5C;    /* texto secundario */
  --papel:#FBFBFA;          /* fondo */
  --panel:#F0EFED;          /* fondo de cajas */
  --linea:#DCDAD5;          /* bordes */
  --senal:#FF0033;          /* acento: el rojo del play */
  --dato:#1D4E5F;           /* acento frío para números */

  --display:'Bricolage Grotesque',system-ui,sans-serif;
  --texto:'Newsreader',Georgia,serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;

  --ancho:min(1180px,100% - 3rem);
  --ancho-texto:66ch;
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--papel);color:var(--tinta);
  font-family:var(--texto);font-size:1.15rem;line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;height:auto;display:block}
a{color:var(--tinta);text-decoration-color:var(--senal);text-underline-offset:3px}
:focus-visible{outline:3px solid var(--senal);outline-offset:3px}

/* ── barra de progreso de scroll (como la de un video) ─────────── */
#progreso{
  position:fixed;top:0;left:0;height:4px;width:0%;
  background:var(--senal);z-index:99;transition:width .1s linear;
}

/* ── portada ───────────────────────────────────────────────────── */
.portada{
  width:var(--ancho);margin-inline:auto;
  padding:clamp(3rem,10vh,7rem) 0 clamp(2rem,6vh,4rem);
  border-bottom:1px solid var(--linea);
}
.sello{
  font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--tinta-suave);margin:0 0 1.5rem;
}
.portada h1{
  font-family:var(--display);font-weight:800;
  font-size:clamp(2.6rem,8vw,5.6rem);line-height:.95;
  letter-spacing:-.03em;margin:0 0 1.5rem;max-width:16ch;
}
.portada h1 em{font-style:normal;color:var(--senal)}
.bajada{
  font-size:clamp(1.15rem,2.2vw,1.45rem);color:var(--tinta-suave);
  max-width:52ch;margin:0 0 2.5rem;font-weight:300;
}

/* ── fichas de números ─────────────────────────────────────────── */
.fichas{
  display:grid;gap:1px;background:var(--linea);
  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  border:1px solid var(--linea);
}
.ficha{background:var(--papel);padding:1.25rem 1rem}
.ficha b{
  display:block;font-family:var(--display);font-weight:700;
  font-size:clamp(1.6rem,3.4vw,2.3rem);line-height:1;
  letter-spacing:-.02em;color:var(--dato);
}
.ficha span{
  display:block;margin-top:.4rem;font-family:var(--mono);
  font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;
  color:var(--tinta-suave);line-height:1.4;
}

/* ── secciones de gráfico ──────────────────────────────────────── */
.capitulo{
  width:var(--ancho);margin-inline:auto;
  padding:clamp(3.5rem,9vh,6rem) 0;
  border-bottom:1px solid var(--linea);
}
.chapa{
  display:inline-flex;align-items:center;gap:.5rem;
  background:var(--tinta);color:#fff;border-radius:4px;
  padding:.3rem .6rem;font-family:var(--mono);font-size:.72rem;
  letter-spacing:.06em;margin-bottom:1.25rem;
}
.chapa i{
  width:6px;height:6px;border-radius:50%;
  background:var(--senal);font-style:normal;
}
.capitulo h2{
  font-family:var(--display);font-weight:700;
  font-size:clamp(1.75rem,4.2vw,2.9rem);line-height:1.08;
  letter-spacing:-.025em;margin:0 0 1.25rem;max-width:22ch;
}
.capitulo p{max-width:var(--ancho-texto);margin:0 0 1.15rem}
.capitulo p:last-of-type{margin-bottom:0}
.destacado{
  font-family:var(--display);font-weight:400;font-size:1.35rem;
  line-height:1.45;border-left:3px solid var(--senal);
  padding-left:1.15rem;color:var(--tinta);
}

/* ── contenedor del gráfico ────────────────────────────────────── */
.grafico{
  margin:2.25rem 0 1.5rem;background:#fff;
  border:1px solid var(--linea);padding:.75rem;
}
.grafico iframe{width:100%;border:0;display:block}
.pie{
  font-family:var(--mono);font-size:.74rem;line-height:1.6;
  color:var(--tinta-suave);max-width:var(--ancho-texto);
  padding-top:.25rem;
}
.pie b{color:var(--tinta);font-weight:400}

/* hueco visible mientras no pegaste el embed — se borra solo al pegarlo */
.pendiente{
  display:grid;place-content:center;text-align:center;gap:.5rem;
  min-height:380px;background:var(--panel);
  border:2px dashed var(--linea);
  font-family:var(--mono);font-size:.8rem;color:var(--tinta-suave);
  padding:2rem;
}
.pendiente strong{color:var(--senal);font-weight:400}

/* ── método y cierre ───────────────────────────────────────────── */
.metodo{background:var(--panel);border-block:1px solid var(--linea)}
.metodo .capitulo{border-bottom:0}
.metodo ol{max-width:var(--ancho-texto);padding-left:1.3rem;margin:0}
.metodo li{margin-bottom:.85rem}
.aviso{
  max-width:var(--ancho-texto);margin-top:2rem;padding:1.15rem 1.35rem;
  background:var(--papel);border:1px solid var(--linea);
  border-left:3px solid var(--dato);font-size:1rem;
}
.aviso h3{
  font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;
  text-transform:uppercase;margin:0 0 .6rem;color:var(--dato);
}
.aviso p{margin:0 0 .6rem}
.aviso p:last-child{margin:0}

footer{
  width:var(--ancho);margin-inline:auto;
  padding:3rem 0;font-family:var(--mono);font-size:.76rem;
  color:var(--tinta-suave);display:flex;gap:1.5rem;flex-wrap:wrap;
  justify-content:space-between;
}

@media (max-width:640px){
  body{font-size:1.05rem}
  .destacado{font-size:1.15rem}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  #progreso{transition:none}
}
</style>
</head>

